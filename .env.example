# Copier en .env (jamais commité).
REPO=owner/vigie
# Ton propre token GitHub fine-grained, limité à ce dépôt :
# contents, issues, pull requests, commit statuses en écriture.
# Seul ton compte apparaîtra sur GitHub (pas de compte bot).
GH_TOKEN=
# Ton identité Git (adresse noreply GitHub conseillée : <id>+<login>@users.noreply.github.com)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Généré par `claude setup-token` (abonnement Claude)
CLAUDE_CODE_OAUTH_TOKEN=
WIP_LIMIT=1
TICK_SECONDS=60
BACKOFF_SECONDS=1800
# Notifications ntfy de l'orchestrateur (facultatives ; les agents ne les voient pas).
# Serveur ntfy (https://ntfy.sh par défaut, ou ton propre serveur).
NTFY_URL=https://ntfy.sh
# Topic : vide = notifications désactivées. Sur ntfy.sh, le topic vaut mot de passe :
# aléatoire, au moins 32 caractères parmi [-_A-Za-z0-9] (64 au plus).
NTFY_TOPIC=
# Jeton d'accès (tk_...) pour un serveur ou un topic protégé ; facultatif.
NTFY_TOKEN=
