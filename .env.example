# Copier en .env (jamais commité).
REPO=owner/vigie
# Ton propre token GitHub fine-grained, limité à ce dépôt :
# contents, issues, pull requests, commit statuses en écriture.
# Seul ton compte apparaîtra sur GitHub (pas de compte bot).
GH_TOKEN=
# Ton identité Git (adresse noreply GitHub conseillée : <id>+<login>@users.noreply.github.com)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Généré par `claude setup-token` (abonnement Claude)
CLAUDE_CODE_OAUTH_TOKEN=
WIP_LIMIT=1
TICK_SECONDS=60
BACKOFF_SECONDS=1800
